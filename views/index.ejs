<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Weather App</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

</head>
<body>

<%- include('partials/header') %>

<main class="container pb-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="glass-card p-3 mb-4">

                <form action="/" method="POST">

                    <div class="input-group">

                        <input
                            type="text"
                            class="form-control border-0 shadow-none"
                            name="city"
                            value="<%= city %>"
                            placeholder="Enter city name..."
                            autocomplete="off"
                            required>

                        <button class="btn btn-search px-4">

                            Search

                        </button>

                    </div>

                </form>

            </div>

            <% if(error){ %>

            <div class="alert alert-danger shadow-sm rounded-4">

                <strong>⚠</strong>

                <%= error %>

            </div>

            <% } %>

            <% if(weather){ %>

            <div class="glass-card weather-card p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h2 class="fw-bold mb-0 text-white">

                            <%= weather.city %>

                        </h2>

                        <span class="text-white-50">

                            <%= weather.country %>

                        </span>

                    </div>

                    <img
                    src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png"
                    width="90">

                </div>

                <div class="text-center my-4">

                    <h1 class="display-1 fw-bold text-white mb-0">

                        <%= weather.temp %>°

                    </h1>

                    <h5 class="text-capitalize text-info">

                        <%= weather.description %>

                    </h5>

                </div>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="info-box">

                            <small>

                                Feels Like

                            </small>

                            <h5>

                                <%= weather.feelsLike %>°C

                            </h5>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="info-box">


                            <small>

                                Humidity

                            </small>

                            <h5>

                                <%= weather.humidity %>%

                            </h5>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="info-box">


                            <small>

                                Wind

                            </small>

                            <h5>

                                <%= weather.wind %> m/s

                            </h5>

                        </div>

                    </div>

                </div>

            </div>

            <% } %>

            <% if(!weather && !error){ %>

            <div class="glass-card text-center p-5">

                <h2 class="display-5">

                    ☀️

                </h2>

                <h5 class="text-white">

                    Search for a city

                </h5>

                <p class="text-white-50 mb-0">

                    Enter any city above to view the latest weather.

                </p>

            </div>

            <% } %>

        </div>

    </div>

</main>

<%- include('partials/footer') %>

</body>
</html>